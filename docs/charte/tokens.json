{
  "nom": "TrialRevive",
  "version": "1.0",
  "couleurs": {
    "noir":       { "hex": "#0A0A0A", "role": "titres, logo, aplats forts, en-têtes de tableaux" },
    "anthracite": { "hex": "#262626", "role": "texte courant" },
    "graphite":   { "hex": "#4A4A4A", "role": "sous-titres, texte secondaire" },
    "gris_moyen": { "hex": "#6E6E6E", "role": "légendes, numéros de page ; gris le plus clair autorisé pour du texte sur blanc" },
    "gris_clair": { "hex": "#BDBDBD", "role": "icônes discrètes, flèches, texte sur fond noir" },
    "perle":      { "hex": "#E4E4E4", "role": "bordures, cartes" },
    "brume":      { "hex": "#F5F5F5", "role": "fonds d'encadrés et de cartes" },
    "blanc":      { "hex": "#FFFFFF", "role": "fond par défaut" },
    "filet":      { "hex": "#D9D9D9", "role": "filets fins sous les titres, en-tête et pied de page" }
  },
  "proportions": { "blanc_et_brume": "60 %", "gris": "30 %", "noir": "10 %" },
  "typographie": {
    "police": "Manrope",
    "repli": ["Arial", "sans-serif"],
    "graisses": { "fine": 200, "texte": 400, "moyenne": 500, "forte": 800, "gras_documents": 700 },
    "documents_word": { "corps_pt": 10, "titre_pt": 26, "section_pt": 15, "sous_section_pt": 11.5, "interligne": 1.12 },
    "slides_16_9": { "titre_pt": 34, "surtitre_pt": 13, "titre_carte_pt": 19, "texte_pt": "15-17", "legende_pt": 12 },
    "approche": { "titres": "-0.04em", "surtitres_capitales": "0.16em" }
  },
  "formes": { "rayon_coins": 0, "filet_fin_px": 1, "filet_accent_px": 2, "barre_encadre_px": 4 },
  "logo": {
    "versions": ["horizontal", "empile", "symbole", "icone_carree"],
    "couleurs": ["noir sur fond clair", "blanc sur fond noir ou graphite"],
    "zone_de_protection": "la moitié de la largeur du symbole, tout autour",
    "taille_minimale_symbole_px": 24
  }
}
